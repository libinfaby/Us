{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pingu-codu-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],

  // 02:30 UTC = 08:00 IST - daily countdown/anniversary reminders (src/lib/reminders.ts).
  "triggers": { "crons": ["30 2 * * *"] },

  // Filled in after running `npx wrangler d1 create pingu-codu-db` (Phase 3 step 2).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pingu-codu-db",
      "database_id": "a3d141bb-af71-4571-9bbe-a9650aaeb1a5"
    }
  ]
}
